%% MAIN SCRIPT TO TRANSFORM THE NUMERICAL SOLUTIONS

format long            % Display numerical results with high precision
clear                  % Clear all variables from workspace
clc                    % Clear command window
close all              % Close all figure windows

%----------------------- LOAD SOLUTION AND MODEL --------------------------

% Below, we can find two situations:
% - Case 1: The simulation is performed in a single run.
% - Case 2: The simulation is performed in multiple parts.
% At the end, it is recommended to save the combined results and use Case 1
% to view the results in future sessions.

% List of filenames to load (including the .mat extension)
% You must manually ENTER THE NAMES OF THE saved result FILES in the correct order
file_ids_sol  = {'Saved_solutions3_37.mat', 'Saved_solutions40.mat', 'Saved_solutions16_5.mat'};
N_parts       = numel(file_ids_sol);

% If you want to COMBINE THE "Saved_vars" FILES too, you must manually ENTER THE NAMES OF THE
% FILES in the correct order.
% If you want to merge the files, set Combine_vars=1; otherwise, set Combine_vars=0.
Combine_vars  = 0;
file_ids_vars = {'Saved_vars5.mat', 'Saved_vars25.mat'};
N_parts_vars  = numel(file_ids_vars);

folderName    = 'results';

if N_parts==1
    %Case 1: Load the complete solution:
    aux         = load(file_ids_sol{1});
    sol_n_save  = aux.sol_n_save;
    sol_n_save  = sol_n_save(~cellfun('isempty', sol_n_save));
    
elseif N_parts>1 
    %Case 2: Load solution in many parts:
    sol_n_save = {};
    
    for k = 1:N_parts
        filename    = file_ids_sol{k};
        aux         = load(filename);
    
        current_sol = aux.sol_n_save;
        if k ~= 1
            current_sol = current_sol(3:end, :);
        end
        current_sol = current_sol(~cellfun('isempty', current_sol));
        sol_n_save  = [sol_n_save; current_sol];
    end
    save(fullfile(folderName, 'Saved_solutionsFull.mat'),'sol_n_save')

    %EXTRA: Combination of the save_vars files
    if Combine_vars==1 && N_parts_vars>=2
        save_vars = {};
        for k = 1:N_parts
            filename_vars    = file_ids_vars{k};
            aux_vars         = load(filename_vars);
        
            current_vars = aux_vars.save_vars;
            if k ~= 1
                current_vars = current_vars(3:end, :);
            end
            current_vars = current_vars(~cellfun('isempty', current_vars));
            save_vars  = [save_vars; current_vars];
        end
        save(fullfile(folderName, 'Saved_varsFull.mat'),'save_vars')
    end
end

sol_size     = size(sol_n_save,1);

%Load Model:
aux2         = load('Model.mat');
p            = aux2.p;
model_l      = aux2.model_l;
model_g      = aux2.model_g;

xiplot       = linspace(-1.0, 1.0, (p+1)^2);

%-------------------------- INITIALIZE VARIABLES --------------------------

t_n          = cell(sol_size,1);
xplot_l      = cell(sol_size,1);
xplot_g      = cell(sol_size,1);
V_liq        = cell(sol_size,1);
V_gas        = cell(sol_size,1);
num_sol_l    = cell(sol_size,1);
num_sol_g    = cell(sol_size,1);
dnum_sol_l   = cell(sol_size,1);
dnum_sol_g   = cell(sol_size,1);
num_sol_ql   = cell(sol_size,1);
num_sol_qg   = cell(sol_size,1);

rhoy_l      = cell(sol_size,1);
rhoy_g      = cell(sol_size,1);
for i = 1:sol_size
    rhoy_l{i} = cell(model_l.nSpecies,1);
    rhoy_g{i} = cell(model_g.nSpecies,1);
end
rho_l       = cell(sol_size,1);
rho_g       = cell(sol_size,1);
y_l         = cell(sol_size,1);
y_g         = cell(sol_size,1);
T_l         = cell(sol_size,1);
T_l_0       = cell(sol_size,1);
T_g         = cell(sol_size,1);
v_l         = cell(sol_size,1);
v_g         = cell(sol_size,1);
m_l         = cell(sol_size,1);
m_g_i       = cell(sol_size, 1);
for i = 1:model_l.nSpecies
    m_g_i{i} = cell(1, model_l.nSpecies);
end
m_g         = cell(sol_size,1);
rhoy_ql     = cell(sol_size,1);
rhoy_qg     = cell(sol_size,1);
for i = 1:sol_size
    rhoy_ql{i} = cell(model_l.nSpecies,1);
    rhoy_qg{i} = cell(model_g.nSpecies,1);
end
rho_ql      = cell(sol_size,1);
rho_qg      = cell(sol_size,1);
y_ql        = cell(sol_size,1);
y_ql_i      = cell(sol_size, 1);
for i = 1:model_l.nSpecies
    y_ql_i{i} = cell(1, model_l.nSpecies);
end
y_qg        = cell(sol_size,1);
T_ql        = cell(sol_size,1);
T_qg        = cell(sol_size,1);
v_qg        = cell(sol_size,1);

xmesh_l_n   = cell(sol_size,1);
xmesh_g_n   = cell(sol_size,1);
wmesh_l_n   = cell(sol_size,1);
wmesh_g_n   = cell(sol_size,1);

d           = cell(sol_size,1);

f_l         = cell(sol_size,1);
f_g         = cell(sol_size,1);
f_dif_l     = cell(sol_size,1);
f_dif_g     = cell(sol_size,1);
f_conv_l    = cell(sol_size,1);
f_conv_g    = cell(sol_size,1);
for i = 1:sol_size
    f_conv_l{i} = cell(model_l.nDiff,1);
    f_conv_g{i} = cell(model_g.nDiff,1);
end

%----------------------- SOLUTION TRANSFORMATION --------------------------
 
%NOTE: It is useful to use this loop to make videos 
for ii=1:sol_size
    u_l            = sol_n_save{ii}.ul;
    u_g            = sol_n_save{ii}.ug;
    fes_l          = sol_n_save{ii}.fesl;
    fes_g          = sol_n_save{ii}.fesg;
    mesh_l         = sol_n_save{ii}.fesl.mesh;
    mesh_g         = sol_n_save{ii}.fesg.mesh;
    nElems_l       = sol_n_save{ii}.fesl.mesh.nElems;
    nElems_g       = sol_n_save{ii}.fesg.mesh.nElems;
    w              = sol_n_save{ii}.w;

    t_n{ii}        = sol_n_save{ii}.t;
    xplot_l{ii}    = PhysicalCoordinates(mesh_l, xiplot);
    xplot_g{ii}    = PhysicalCoordinates(mesh_g, xiplot);
    num_sol_l{ii}  = EvalSolution(u_l, fes_l, 1:nElems_l, xiplot);
    num_sol_g{ii}  = EvalSolution(u_g, fes_g, 1:nElems_g, xiplot);
    dnum_sol_l{ii} = EvalSolution_dx(u_l, fes_l, 1:nElems_l, xiplot);
    dnum_sol_g{ii} = EvalSolution_dx(u_g, fes_g, 1:nElems_g, xiplot);
    num_sol_ql{ii} = sol_n_save{ii}.qL;
    num_sol_qg{ii} = sol_n_save{ii}.qR;
    M_matrix_liq   = MassMatrix(fes_l);
    M_matrix_gas   = MassMatrix(fes_g);
    
    xmesh_l_n{ii}  = mesh_l.x_faces;
    xmesh_g_n{ii}  = mesh_g.x_faces;
    wmesh_l_n{ii}  = w * (xmesh_l_n{ii}-xmesh_l_n{ii}(1))/(xmesh_l_n{ii}(end)-xmesh_l_n{ii}(1));
    wmesh_g_n{ii}  = w * (xmesh_g_n{ii}-xmesh_g_n{ii}(end))/(xmesh_g_n{ii}(1)-xmesh_g_n{ii}(end));

    d{ii}          = mesh_l.x_faces(end,end)*2;

    for jj = 1:model_l.nSpecies
        rhoy_l{ii}{jj} = num_sol_l{ii}{jj}; 
    end
    for jj = 1:model_g.nSpecies
        rhoy_g{ii}{jj} = num_sol_g{ii}{jj}; 
    end
    [rho_l{ii},y_l{ii}] = calc_rho_y(rhoy_l{ii}, model_l);
    [rho_g{ii},y_g{ii}] = calc_rho_y(rhoy_g{ii}, model_g);
    H_l                 = num_sol_l{ii}{model_l.nDiff};
    H_g                 = num_sol_g{ii}{model_g.nDiff};
    T_l{ii}             = calc_T(H_l,rhoy_l{ii},model_l);
    T_l_0{ii}           = T_l{ii}(1,1);
    T_g{ii}             = calc_T(H_g,rhoy_g{ii},model_g);
    v_l{ii}             = num_sol_l{ii}{model_l.nDiff+1};
    v_g{ii}             = num_sol_g{ii}{model_g.nDiff+1};

    for jj = 1:model_l.nSpecies
        rhoy_ql{ii}{jj} = num_sol_ql{ii}(jj);
    end
    for jj = 1:model_g.nSpecies
        rhoy_qg{ii}{jj} = num_sol_qg{ii}(jj);
    end
    [rho_ql{ii},y_ql{ii}] = calc_rho_y(rhoy_ql{ii}, model_l);
    for i = 1:model_l.nSpecies
        y_ql_i{ii}{i} = y_ql{ii}{i};
    end
    [rho_qg{ii},y_qg{ii}] = calc_rho_y(rhoy_qg{ii}, model_g);
    H_ql           = num_sol_ql{ii}(model_l.nSpecies+1);
    H_qg           = num_sol_qg{ii}(model_g.nSpecies+1);
    T_ql{ii}       = calc_T(H_ql,rhoy_ql{ii},model_l);
    T_qg{ii}       = calc_T(H_qg,rhoy_qg{ii},model_g);
    v_qg{ii}       = num_sol_qg{ii}(model_g.nSpecies+2);

    m_l{ii}        = rho_ql{ii}*(v_l{ii}(end,end)-w);
    m_g{ii}        = rho_qg{ii}*(v_qg{ii}-w);

    y_qfuel        = 0;
    for i=1:model_l.nSpecies
        y_qfuel = y_qfuel + y_qg{ii}{i+model_g.nInerts};
    end
    epsilon        = cell(model_l.nSpecies);
    for i=1:model_l.nSpecies
        epsilon{i} = y_qg{ii}{i+model_g.nInerts}/y_qfuel;
        m_g_i{ii}{i} = rho_qg{ii}*epsilon{i}*(v_qg{ii}-w);
    end

    uw_l           = [ u_l; {P1ToQX(wmesh_l_n{ii}, fes_l)} ];
    uw_g           = [ u_g; {P1ToQX(wmesh_g_n{ii}, fes_g)} ];
    u_qp_l         = EvalSolution(uw_l, fes_l, 1:nElems_l, fes_l.QuadRule.xi);
    u_qp_g         = EvalSolution(uw_g, fes_g, 1:nElems_g, fes_g.QuadRule.xi);
    du_dx_qp_l     = EvalSolution_dx(uw_l, fes_l, 1:nElems_l, fes_l.QuadRule.xi);
    du_dx_qp_g     = EvalSolution_dx(uw_g, fes_g, 1:nElems_g, fes_g.QuadRule.xi);

    f_l{ii}        = model_l.fQg(model_l,t_n{ii},xplot_l{ii},u_qp_l,du_dx_qp_l,false); 
    f_dif_l{ii}    = model_l.f_diffusive(model_l,u_qp_l,du_dx_qp_l,false);
    for jj=1:model_l.nDiff
        f_conv_l{ii}{jj} = u_qp_l{jj}.*(u_qp_l{end-1}-u_qp_l{end});
    end
    f_g{ii}        = model_g.fQg(model_g,t_n{ii},xplot_g{ii},u_qp_g,du_dx_qp_g,false); 
    f_dif_g{ii}    = model_g.f_diffusive(model_g,u_qp_g,du_dx_qp_g,false);
    for jj = 1:model_g.nDiff
        f_conv_g{ii}{jj} = u_qp_g{jj}.*(u_qp_g{end-1}-u_qp_g{end});
    end
    
    disp(ii)
end

%----------------------- SAVE SPECIFIC RESULTS ----------------------------

%Save specific results in a .mat file to make them more manageable:
save(fullfile(folderName, 'Heptano + E.mat'),'t_n','m_l','m_g','d','T_ql','T_l_0')